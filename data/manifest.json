  "void_ratio_definitions": {
    "VoidRatioInitialWaterContent": {
      "previous_column": "VoidRatioUnshifted",
      "units": "dimensionless",
      "basis": "Initial water content, initial wet mass and specimen volume, assumed particle specific gravity, and subsequent measured volume change.",
      "formula": "m_d = m_i/(1+w_i); e(t) = G_s*rho_w*(V_i+DeltaV(t))/m_d - 1; w_i is a mass fraction; DeltaV is positive for volume increase."
    },
    "VoidRatioFinalWaterContentShifted": {
      "previous_column": "VoidRatioCorrected",
      "units": "dimensionless",
      "basis": "The initial-water-content series shifted by a constant to match final water content and assumed particle specific gravity under full saturation (S_r=1).",
      "formula": "e_shifted(t) = e_initial(t) + (w_f*G_s - e_initial,end); w_f is a mass fraction.",
      "rounding": "The implemented shift uses saved rounded e_f_eq51 - e_f_volumeChange; a small rounding residual can remain."
    }
  },
